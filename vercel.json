{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/evaluate", "dest": "/api/evaluate.js" },
    { "src": "/api/benchmark", "dest": "/api/benchmark.js" },
    { "src": "/api/diagnose", "dest": "/api/diagnose.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
